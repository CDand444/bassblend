# pi-gen settings for the BassBlend SD card image (Raspberry Pi OS Lite 64-bit + BassBlend).
IMG_NAME=bassblend
PI_GEN_RELEASE="BassBlend"
RELEASE=trixie
TARGET_HOSTNAME=bassblend
# No password is baked in. Raspberry Pi Imager's "OS customisation" (cloud-init) can add a
# user, SSH and Wi-Fi when writing the card; BassBlend itself needs none of them.
FIRST_USER_NAME=pi
ENABLE_SSH=0
LOCALE_DEFAULT=en_US.UTF-8
KEYBOARD_KEYMAP=us
KEYBOARD_LAYOUT="English (US)"
TIMEZONE_DEFAULT=Etc/UTC
WPA_COUNTRY=US
STAGE_LIST="stage0 stage1 stage2 stage-bassblend"
DEPLOY_COMPRESSION=xz
COMPRESSION_LEVEL=6
