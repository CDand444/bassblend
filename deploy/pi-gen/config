# pi-gen settings for the htTamer SD card image (Raspberry Pi OS Lite 64-bit + htTamer).
IMG_NAME=httamer
PI_GEN_RELEASE="htTamer"
RELEASE=trixie
TARGET_HOSTNAME=httamer
# No password is baked in. Raspberry Pi Imager's "OS customization" (cloud-init) can add a
# user, SSH and Wi-Fi when writing the card; htTamer itself needs none of them.
FIRST_USER_NAME=pi
ENABLE_SSH=0
LOCALE_DEFAULT=en_US.UTF-8
KEYBOARD_KEYMAP=us
KEYBOARD_LAYOUT="English (US)"
TIMEZONE_DEFAULT=Etc/UTC
WPA_COUNTRY=US
STAGE_LIST="stage0 stage1 stage2 stage-httamer"
DEPLOY_COMPRESSION=xz
COMPRESSION_LEVEL=6
