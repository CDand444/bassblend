# Shell scripts must keep Unix line endings or bash on the Pi refuses them.
*.sh        text eol=lf
*.service   text eol=lf
*.rules     text eol=lf
# Windows launcher
*.cmd       text eol=crlf
deploy/linux/httamer-update text eol=lf
deploy/linux/bassblend-update text eol=lf
deploy/linux/httamer-ota text eol=lf

# Development-only files: kept in the repository, left out of the source archives devices download
# (GitHub release tarballs, which the Pi's in-app updates install) and of the Pi image.
# deploy/linux stays: the Pi's updater and installer live there.
CLAUDE.md       export-ignore
tests/**        export-ignore
.github/**      export-ignore
deploy/pi-gen/** export-ignore
deploy/windows/** export-ignore
.gitattributes  export-ignore
.gitignore      export-ignore
docs/dev/** export-ignore
